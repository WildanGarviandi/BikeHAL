aidl_interface {
    name: "EleglideBikeInterface",
    vendor_available: true,
    srcs: [
        "com/garvield/bike/hardware/*.aidl",
    ],
    unstable: true, // still needs to determine what else capability that can be done
    backend: {
        rust: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
        java: {
            enabled: true,
        }
    },
}
